#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
TECMP-Tool Packet Factory - Complete Original Code
Clean version without mocks or fallbacks, using real classes.
"""

import logging
from typing import Dict, Any, Optional, List, Type
from dataclasses import dataclass
from enum import Enum, auto

# Direct imports of real packet classes
from core.packets.transport.udp import UDPPacket
from core.packets.transport.tcp import TCPPacket
from core.packets.tecmp.tecmp_packet import TECMPPacket
from core.packets.tecmp.tecmp_data import TECMPData


class PacketCreationStatus(Enum):
    """Packet creation status"""
    SUCCESS = auto()
    ERROR = auto()


@dataclass
class PacketCreationResult:
    """Packet creation result"""
    status: PacketCreationStatus
    packet: Optional[Any] = None
    error_message: Optional[str] = None
    factory_used: Optional[str] = None


class PacketCreationError(Exception):
    """Exception for packet creation errors"""
    pass


class EthernetPacketFactory:
    """Factory for Ethernet packets"""
    
    @staticmethod
    def create_packet(src_mac: str = "00:11:22:33:44:55", 
                     dst_mac: str = "aa:bb:cc:dd:ee:ff", 
                     ether_type: int = 0x0800,
                     **kwargs) -> Any:
        """Create an Ethernet packet"""
        try:
            from core.packets.base.ethernet import EthernetPacket, MacAddress
            return EthernetPacket(
                src_mac=MacAddress(src_mac),
                dst_mac=MacAddress(dst_mac),
                ether_type=ether_type,
                **kwargs
            )
        except ImportError:
            # Simple fallback if EthernetPacket doesn't exist
            return {
                'type': 'ethernet',
                'src_mac': src_mac,
                'dst_mac': dst_mac,
                'ether_type': ether_type,
                **kwargs
            }


class IPv4PacketFactory:
    """Factory for IPv4 packets"""
    
    @staticmethod
    def create_packet(src_ip: str = "192.168.1.100",
                     dst_ip: str = "192.168.1.200", 
                     ttl: int = 64,
                     protocol: int = 6,
                     **kwargs) -> Any:
        """Create an IPv4 packet"""
        try:
            from core.packets.network.ipv4 import IPv4Packet
            return IPv4Packet(
                src_ip=src_ip,
                dst_ip=dst_ip,
                ttl=ttl,
                **kwargs
            )
        except ImportError:
            # Simple fallback
            return {
                'type': 'ipv4',
                'src_ip': src_ip,
                'dst_ip': dst_ip,
                'ttl': ttl,
                'protocol': protocol,
                **kwargs
            }


class IPv6PacketFactory:
    """Factory for IPv6 packets"""
    
    @staticmethod
    def create_packet(src_ip: str = "2001:db8::1",
                     dst_ip: str = "2001:db8::2",
                     hop_limit: int = 64,
                     **kwargs) -> Any:
        """Create an IPv6 packet"""
        try:
            from core.packets.network.ipv6 import IPv6Packet
            return IPv6Packet(
                src_ip=src_ip,
                dst_ip=dst_ip,
                hop_limit=hop_limit,
                **kwargs
            )
        except ImportError:
            # Simple fallback
            return {
                'type': 'ipv6',
                'src_ip': src_ip,
                'dst_ip': dst_ip,
                'hop_limit': hop_limit,
                **kwargs
            }


class TCPPacketFactory:
    """Factory for TCP packets"""
    
    @staticmethod
    def create_packet(src_port: int = 12345,
                     dst_port: int = 80,
                     seq_number: int = 0,
                     ack_number: int = 0,
                     flags: int = 0x02,  # SYN
                     window_size: int = 8192,
                     **kwargs) -> TCPPacket:
        """Create a TCP packet"""
        return TCPPacket(
            src_port=src_port,
            dst_port=dst_port,
            seq_number=seq_number,
            ack_number=ack_number,
            data_offset=kwargs.get('data_offset', 5),
            reserved=kwargs.get('reserved', 0),
            flags=flags,
            window_size=window_size,
            checksum=kwargs.get('checksum', 0),
            urgent_pointer=kwargs.get('urgent_pointer', 0),
            payload=kwargs.get('payload', b''),
            **{k: v for k, v in kwargs.items() if k not in [
                'data_offset', 'reserved', 'checksum', 'urgent_pointer', 'payload'
            ]}
        )


class UDPPacketFactory:
    """Factory for UDP packets"""
    
    @staticmethod
    def create_packet(src_port: int = 12345,
                     dst_port: int = 53,
                     **kwargs) -> UDPPacket:
        """Create a UDP packet"""
        return UDPPacket(
            src_port=src_port,
            dst_port=dst_port,
            payload=kwargs.get('payload', b''),
            **{k: v for k, v in kwargs.items() if k != 'payload'}
        )


class ARPPacketFactory:
    """Factory for ARP packets"""
    
    @staticmethod
    def create_packet(operation: int = 1,  # Request
                     sender_hw_addr: str = "00:11:22:33:44:55",
                     sender_proto_addr: str = "192.168.1.100",
                     target_hw_addr: str = "00:00:00:00:00:00",
                     target_proto_addr: str = "192.168.1.200",
                     **kwargs) -> Any:
        """Create an ARP packet"""
        try:
            from core.packets.network.arp import ARPPacket
            return ARPPacket(
                src_mac=sender_hw_addr,
                src_ip=sender_proto_addr,
                dst_mac=target_hw_addr,
                dst_ip=target_proto_addr,
                op=operation,
                **kwargs
            )
        except ImportError:
            # Simple fallback
            return {
                'type': 'arp',
                'operation': operation,
                'sender_hw_addr': sender_hw_addr,
                'sender_proto_addr': sender_proto_addr,
                'target_hw_addr': target_hw_addr,
                'target_proto_addr': target_proto_addr,
                **kwargs
            }


