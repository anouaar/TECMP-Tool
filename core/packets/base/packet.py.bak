                'priority': priority,
                'ether_type': ether_type,
                **kwargs
            }


class TECMPPacketFactory:
    """Factory for TECMP packets"""
    
    @staticmethod
    def create_packet(device_id: int = 0x0080,
                     counter: int = 0,
                     version: int = 3,
                     message_type: int = 0x03,
                     data_type: int = 0x80,
                     device_flags: int = 0x0007,
                     interface_id: int = 0x00002d4a,
                     data_flags: int = 0x0000,
                     payload: bytes = b"",
                     **kwargs) -> TECMPPacket:
        """Create a TECMP packet"""
        return TECMPPacket(
            data=payload,
            device_id=device_id,
            counter=counter,
            version=version,
            message_type=message_type,
            data_type=data_type,
            device_flags=device_flags,
            interface_id=interface_id,
            data_flags=data_flags,
            **kwargs
        )
    
    @staticmethod
    def create_ethernet_packet(device_id: int = 0x0080, **kwargs) -> TECMPPacket:
        """Create a TECMP packet for Ethernet data"""
        return TECMPPacketFactory.create_packet(
            device_id=device_id,
            data_type=0x80,  # Ethernet
            **kwargs
        )
    
    @staticmethod
    def create_can_packet(device_id: int = 0x0080, **kwargs) -> TECMPPacket:
        """Create a TECMP packet for CAN data"""
        return TECMPPacketFactory.create_packet(
            device_id=device_id,
            data_type=0x02,  # CAN
            **kwargs
        )
    
    @staticmethod
    def create_with_encapsulated(encapsulated_packet: Any, 
                               device_id: int = 0x0080,
                               **kwargs) -> TECMPPacket:
        """Create a TECMP packet encapsulating another packet"""
        tecmp = TECMPPacketFactory.create_packet(device_id=device_id, **kwargs)
        if hasattr(tecmp, 'encapsulate'):
            tecmp.encapsulate(encapsulated_packet)
        return tecmp


class PacketFactoryRegistry:
    """Main registry for all packet factories"""
    
    def __init__(self):
        self.logger = logging.getLogger("TECMP-Tool.PacketFactoryRegistry")
        
        # Factory registry
        self._factories = {
            'ethernet': EthernetPacketFactory,
            'ipv4': IPv4PacketFactory,
            'ipv6': IPv6PacketFactory,
            'tcp': TCPPacketFactory,
            'udp': UDPPacketFactory,
            'arp': ARPPacketFactory,
            'vlan': VLANPacketFactory,
            'tecmp': TECMPPacketFactory
        }
        
        # Statistics
        self._creation_stats = {}
        self._error_stats = {}
        
        # Callbacks
        self._creation_callbacks = []
        self._error_callbacks = []
        
        self.logger.info("PacketFactoryRegistry initialized")
    
    def create_packet(self, protocol: str, **kwargs) -> PacketCreationResult:
        """
        Create a packet of the specified type
        
        Args:
            protocol: Protocol type (ethernet, tcp, udp, etc.)
            **kwargs: Packet parameters
            
        Returns:
            PacketCreationResult: Creation result
        """
        protocol_lower = protocol.lower()
        
        try:
            # Get the factory
            factory_class = self._factories.get(protocol_lower)
            if not factory_class:
                raise PacketCreationError(f"Unsupported protocol: {protocol}")
            
            # Create the packet
            packet = factory_class.create_packet(**kwargs)
            
            # Update statistics
            self._creation_stats[protocol_lower] = self._creation_stats.get(protocol_lower, 0) + 1
            
            # Notify callbacks
            self._notify_creation_callbacks(protocol, packet, factory_class.__name__)
            
            self.logger.debug(f"Packet {protocol} created successfully")
            
            return PacketCreationResult(
                status=PacketCreationStatus.SUCCESS,
                packet=packet,
                factory_used=factory_class.__name__
            )
            
        except Exception as e:
            # Handle error
            self._error_stats[protocol_lower] = self._error_stats.get(protocol_lower, 0) + 1
            
            error_msg = f"Error creating packet {protocol}: {e}"
            self.logger.error(error_msg)
            
            # Notify error callbacks
            self._notify_error_callbacks(protocol, e)
            
            return PacketCreationResult(
                status=PacketCreationStatus.ERROR,
                error_message=error_msg
            )
    
    def get_available_protocols(self) -> List[str]:
        """Return list of available protocols"""
        return list(self._factories.keys())
    
    def get_statistics(self) -> Dict[str, Any]:
        """Return creation statistics"""
        return {
            'creation_stats': dict(self._creation_stats),
            'error_stats': dict(self._error_stats),
            'available_protocols': len(self._factories)
        }
    
    def add_creation_callback(self, callback):
        """Add callback for successful creations"""
        self._creation_callbacks.append(callback)
    
    def add_error_callback(self, callback):
        """Add callback for errors"""
        self._error_callbacks.append(callback)
    
    def _notify_creation_callbacks(self, protocol: str, packet: Any, factory: str):
        """Notify creation callbacks"""
        for callback in self._creation_callbacks:
            try:
                callback(protocol, packet, factory)
            except Exception as e:
                self.logger.error(f"Error in creation callback: {e}")
    
    def _notify_error_callbacks(self, protocol: str, error: Exception):
        """Notify error callbacks"""
        for callback in self._error_callbacks:
            try:
                callback(protocol, error)
            except Exception as e:
                self.logger.error(f"Error in error callback: {e}")


class PacketFactory:
    """Simple factory for test compatibility"""
    
    def __init__(self):
        self.registry = PacketFactoryRegistry()
        self.logger = logging.getLogger("TECMP-Tool.PacketFactory")
    
    def create_packet(self, packet_type: str, **kwargs) -> Any:
        """
        Create a packet of the specified type
        
        Args:
            packet_type: Type of packet to create
            **kwargs: Packet parameters
            
        Returns:
            Created packet instance
            
        Raises:
            PacketCreationError: If creation fails
        """
        result = self.registry.create_packet(packet_type, **kwargs)
        
        if result.status != PacketCreationStatus.SUCCESS:
            raise PacketCreationError(result.error_message or f"Failed to create packet {packet_type}")
        
        return result.packet
    
    def create(self, packet_type: str, **kwargs) -> Any:
        """Alias for create_packet (compatibility)"""
        return self.create_packet(packet_type, **kwargs)
    
    def get_available_types(self) -> List[str]:
        """Return available packet types"""
        return self.registry.get_available_protocols()


# Global registry instance
_global_registry = None


def get_packet_registry() -> PacketFactoryRegistry:
    """Return global registry instance"""
    global _global_registry
    if _global_registry is None:
        _global_registry = PacketFactoryRegistry()
    return _global_registry


# Convenience functions
def create_packet(protocol: str, **kwargs) -> Any:
    """
    Convenience function to create a packet
    
    Args:
        protocol: Protocol type
        **kwargs: Packet parameters
        
    Returns:
        Created packet instance
        
    Raises:
        PacketCreationError: If creation fails
    """
    registry = get_packet_registry()
    result = registry.create_packet(protocol, **kwargs)
    
    if result.status != PacketCreationStatus.SUCCESS:
        raise PacketCreationError(result.error_message or f"Failed to create packet {protocol}")
    
    return result.packet


def create_ethernet_packet(src_mac: str, dst_mac: str, **kwargs) -> Any:
    """Create an Ethernet packet"""
    return create_packet('ethernet', src_mac=src_mac, dst_mac=dst_mac, **kwargs)


def create_tcp_packet(src_port: int, dst_port: int, **kwargs) -> TCPPacket:
    """Create a TCP packet"""
    return create_packet('tcp', src_port=src_port, dst_port=dst_port, **kwargs)


def create_udp_packet(src_port: int, dst_port: int, **kwargs) -> UDPPacket:
    """Create a UDP packet"""
    return create_packet('udp', src_port=src_port, dst_port=dst_port, **kwargs)


def create_ipv4_packet(src_ip: str, dst_ip: str, **kwargs) -> Any:
    """Create an IPv4 packet"""
    return create_packet('ipv4', src_ip=src_ip, dst_ip=dst_ip, **kwargs)


def create_tecmp_packet(**kwargs) -> TECMPPacket:
    """Create a TECMP packet"""
    return create_packet('tecmp', **kwargs)


def get_available_protocols() -> List[str]:
    """Return list of available protocols"""
    registry = get_packet_registry()
    return registry.get_available_protocols()


def get_packet_statistics() -> Dict[str, Any]:
    """Return packet creation statistics"""
    registry = get_packet_registry()
    return registry.get_statistics()


# Export main functions
__all__ = [
    # Main classes
    'PacketFactory',  # ADDED - simple class for compatibility
    'PacketFactoryRegistry',
    'PacketCreationResult',
    'PacketCreationStatus',
